pipeline {

    agent any

    parameters {

        string(
            name: 'USERS',
            defaultValue: '10',
            description: 'Number of virtual users'
        )

    }

    stages {

        stage('Checkout Code') {

            steps {

                git branch: 'main',
                url: 'https://github.com/pallibalayogi/jenkeins.git'

            }

        }

        stage('Run JMeter Test') {

            steps {

                bat '''
                rmdir /s /q report
                del /f /q result.jtl

                "C:\\Users\\pavan\\Downloads\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3\\bin\\jmeter.bat" ^
                -n ^
                -t Bookstore.jmx ^
                -Jusers=%USERS% ^
                -l result.jtl ^
                -e ^
                -o report
                '''

            }

        }

        stage('Publish HTML Report') {

            steps {

                publishHTML(target: [
                    reportDir: 'report',
                    reportFiles: 'index.html',
                    reportName: 'JMeter HTML Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])

            }

        }

    }

}