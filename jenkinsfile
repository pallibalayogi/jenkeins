pipeline {

    agent any

    parameters {
        string(
            name: 'USERS',
            defaultValue: '10',
            description: 'Number of virtual users'
        )
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/pallibalayogi/jenkeins.git'
            }
        }

        stage('Check Docker') {
            steps {
                bat 'docker --version'
                bat 'docker ps'
            }
        }

        stage('Run JMeter Test In Docker') {
            steps {

                bat '''
                if exist report rmdir /s /q report
                if exist result.jtl del /f /q result.jtl

                docker run --rm ^
                -v %WORKSPACE%:/test ^
                justb4/jmeter ^
                -n ^
                -t /test/Bookstore.jmx ^
                -Jusers=%USERS% ^
                -l /test/result.jtl ^
                -e ^
                -o /test/report
                '''
            }
        }

        stage('Validate SLA') {
            steps {
                script {

                    def content = readFile('result.jtl')

                    if (content.contains('false')) {
                        error("SLA FAILED - Assertions failed")
                    }

                    echo 'SLA Validation Passed'
                }
            }
        }

        stage('Archive Results') {
            steps {
                archiveArtifacts artifacts: 'result.jtl', fingerprint: true
            }
        }

        stage('Publish HTML Report') {
            steps {

                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report',
                    reportFiles: 'index.html',
                    reportName: 'JMeter HTML Report'
                ])

            }
        }

    }

    post {

        success {
            echo 'Pipeline SUCCESS'
        }

        failure {
            echo 'Pipeline FAILED'
        }

        always {
            echo 'Pipeline Finished'
        }
    }
}